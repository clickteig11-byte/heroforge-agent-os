# ============================================================================
# HeroForge V1 — Autonomous Creative Website Studio Environment Configuration
# Copy this file to `.env` if you wish to customize ports or configure live
# AI image generation providers. Zero private keys are stored in this file.
# ============================================================================

# Image Generation Provider Mode:
# - "auto"   : Uses Gemini or OpenAI if a key is present; falls back to manual/existing references
# - "gemini" : Uses Google Gemini Imagen / multimodal generation via GEMINI_API_KEY
# - "openai" : Uses OpenAI image generation via OPENAI_API_KEY
# - "manual" : Uses user-supplied or pre-bundled reference plates via `npm run import:references`
IMAGE_PROVIDER=auto

# Optional API Keys (Leave blank for offline / pre-bundled reference mode)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local Studio Port Allocation
GALLERY_PORT=4100
WEBSITE_A_PORT=4101
WEBSITE_B_PORT=4102

# 3D Pipeline Policy (App-Free Procedural Mode is always enabled)
HEROFORGE_APP_FREE_3D=true
